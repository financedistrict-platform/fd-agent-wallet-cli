# Copy this file to .env and fill in values for your environment.
# .env is gitignored — never commit actual URLs or secrets.

# Override the MCP server URL (default: https://mcp.fd.xyz)
# Set this to point the CLI at a non-production environment.
# FDX_MCP_SERVER=https://...

# Override the OAuth redirect URI (default: http://localhost:6260/oauth/callback)
# FDX_REDIRECT_URI=http://localhost:6260/oauth/callback

# Override the token store path (default: ~/.fdx/auth.json)
# FDX_STORE_PATH=~/.fdx/auth.json
